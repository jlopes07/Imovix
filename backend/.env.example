# =============================================================================
# Imovix backend — variáveis de ambiente de DESENVOLVIMENTO LOCAL
#
#   cp .env.example .env
#
# O arquivo .env é ignorado pelo Git. NUNCA versione credenciais reais.
# Gere senhas fortes, por exemplo:
#   PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
#   Bash:       openssl rand -base64 32
#
# Este arquivo é lido pelo Docker Compose e, no perfil "local", também pelo
# Spring Boot (spring.config.import).
# =============================================================================

# --- PostgreSQL (container) --------------------------------------------------
POSTGRES_DB=imovix
POSTGRES_ADMIN_USER=imovix_admin
POSTGRES_ADMIN_PASSWORD=troque-por-uma-senha-forte-admin
DB_PORT=5432
DB_SCHEMA=imovix

# --- Conexão da aplicação (role com menor privilégio) ------------------------
DB_USERNAME=imovix_app
DB_PASSWORD=troque-por-uma-senha-forte-app
DB_URL=jdbc:postgresql://localhost:5432/imovix?currentSchema=imovix

# --- API ---------------------------------------------------------------------
SERVER_PORT=8080
# Lista separada por vírgula. Nunca use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
