# =============================================================================
# Imovix — .gitignore (monorepo: backend Java/Maven + frontend React/TS)
# Regra de ouro: NUNCA versionar segredos, .env reais, chaves, certificados
# privados ou dumps de banco com dados pessoais (LGPD).
# =============================================================================

# -----------------------------------------------------------------------------
# Segredos e configuração local
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
!*.env.example
application-secrets*.yml
application-secrets*.yaml
application-secrets*.properties

# Chaves, certificados e keystores
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.truststore
id_rsa*
id_ed25519*

# Dumps e backups de banco (podem conter dados pessoais)
*.dump
*.backup
*.bak
*.sql.gz
*.sql.zip
dumps/
backups/

# -----------------------------------------------------------------------------
# Java / Maven
# -----------------------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.properties
.mvn/wrapper/maven-wrapper.jar
*.class
*.log
hs_err_pid*
replay_pid*
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml

# -----------------------------------------------------------------------------
# Node / Frontend
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# -----------------------------------------------------------------------------
# IDEs e editores
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.settings/
.project
.classpath
.factorypath
.apt_generated/
.sts4-cache/
bin/
nbproject/
*.swp
*~

# -----------------------------------------------------------------------------
# Sistema operacional
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Docker / dados locais
# -----------------------------------------------------------------------------
.docker-data/
docker-data/
