# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java segue o Google Java Style (2 espaços), aplicado pelo Spotless
[*.java]
indent_size = 2
max_line_length = 100

[*.{xml,sql}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
